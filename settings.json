{
  "disable_ai": true,
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
  "title_bar": {"show_sign_in": false},
  "scrollbar": { "show": "never" },
  "search": {"search_on_type": false},
  "status_bar": {
    "experimental.show": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "auto_update": false,
  "telemetry": {
    "anthropic_retention": false,
    "diagnostics": false,
    "metrics": false
  },
  "vertical_scroll_margin": 12,
  "cli_default_open_behavior": "existing_window",
  "colorize_brackets": true,
  "lsp_results_location": "picker",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "diagnostics": {
    "inline": {"enabled": true}
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "terminal": {
    "font_size": 14.0,
  },
  "base_keymap": "Zed",
  "cursor_shape": "bar",
  "unnecessary_code_fade": 0.3,
  "minimum_contrast_for_highlights": 100,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 15.0,
  "agent_ui_font_size": 15.0,
  "agent_buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "debugger": {
    "dock": "bottom",
    // set timeout to 5s to prevent crashes on wsl2
    "timeout": 5000,
  },
  "inlay_hints": { "enabled": false, "show_value_hints": false },
  "languages": {
    "Python": {
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "format_on_save": "on",
      "language_servers": [
        "pyrefly",
        "!ty",
        "!basedpyright",
        "!pylsp",
        "!pyright",
        "...",
      ],
    },
    "YAML": {
      "tab_size": 2,
    },
  },
}
