[
    // disable Zed's default space since it's used as leader key in vim mode
    {
        "context": "VimControl && !menu",
        "bindings": {
            "space": null,
        }
    },
    {
        "bindings": {
          "f11": "debugger::StepInto",
          "ctrl-j": "workspace::ActivatePaneDown",
          "ctrl-k": "workspace::ActivatePaneUp",
          "ctrl-h": "workspace::ActivatePaneLeft",
          "ctrl-l": "workspace::ActivatePaneRight"
        }
    },
    // make tab navigation to be ordinal instead of last visited
    {
        "context": "Pane",
        "bindings": {
            "ctrl-tab": "pane::ActivateNextItem",
            "ctrl-shift-tab": "pane::ActivatePreviousItem"
        }
    },
    // hover / signature in any editor mode (insert + normal + visual)
    {
        "context": "Editor",
        "bindings": {
            "alt-h": "editor::Hover",
            "alt-s": "editor::ShowSignatureHelp"
        }
    },
    // move across buffers with shift h/l
    {"context": "Editor && VimControl && !VimWaiting && !menu",
      "bindings": {
        "shift-h": "pane::ActivatePreviousItem",
        "shift-l": "pane::ActivateNextItem",
        "space o f": "workspace::Open"
      }
    },
    // main lazyvim style bindings
    {
        "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
        "bindings": {
            "g u ": "vim::ConvertToUpperCase",
            "space f r": "tab_switcher::Toggle",
            "space ,": "tab_switcher::Toggle",
            "space o f": "workspace::Open",
            "g r": "editor::FindAllReferences",

            // lazyvim's leader s S but global symbol search; use builtin gs for local symbol search
            "space s s": "project_symbols::Toggle",

            "space e": "pane::RevealInProjectPanel",

            // copy paths
            "space y p": "workspace::CopyPath",
            "space y n": "workspace::CopyRelativePath",

            // git
            "space g g": [
                "task::Spawn",
                { "task_name": "lazygit", "reveal_target": "center" }
            ],
            "space g b": "git::Blame",

            // function navigation
            "] f": "vim::NextMethodStart",
            "[ f": "vim::PreviousMethodStart",
            "] F": "vim::NextMethodEnd",
            "[ F": "vim::PreviousMethodEnd",

            // git hunk navigation (same as built in [c and ]c)
            "] h": "editor::GoToHunk",
            "[ h": "editor::GoToPreviousHunk",

            // window splits
            "space w v": "pane::SplitRight",
            "space w s": "pane::SplitDown",
            "space w d": "pane::CloseActiveItem",

            // misc
            "space b d": "pane::CloseActiveItem",
            "space /": "pane::DeploySearch",
            "space s g": "text_finder::Toggle",
            "space space": "file_finder::Toggle",
            "space c a": "editor::ToggleCodeActions",
            "space c r": "editor::Rename",
            "space x x": "diagnostics::Deploy",
            "space u h": "editor::ToggleInlayHints",

            // close tabs to the right/left
            "space w l": "pane::CloseItemsToTheRight",
            "space w h": "pane::CloseItemsToTheLeft",

            "space t t": "workspace::NewCenterTerminal",
        }
    },
    // project panel utils
    {
        "context": "ProjectPanel",
        "bindings": {
            "space e": "workspace::ToggleLeftDock",
            "space c": "project_panel::CollapseAllEntries",
            "space n": "project_panel::NewFile",
            "space r": "project_panel::Rename",
            "space d": "project_panel::Delete"
        }
    },
]
